{
  "name": "achat-planifie",
  "version": "0.0.0",
  "private": true,
  "description": "Plateforme d'achat planifié — cœur financier vérifiable",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && tsx tools/boundaries.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/ui/tsconfig.json && tsc -p apps/web-client/tsconfig.json && tsc -p apps/back-office/tsconfig.json",
    "test:web": "vitest run --config vitest.web.config.ts",
    "openapi:types": "openapi-typescript packages/contracts/openapi.json -o packages/contracts/src/api.d.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:db": "tsx tools/require-docker.ts && vitest run --config vitest.db.config.ts",
    "test:db:local": "tsx tools/local-postgres.ts db",
    "notifications:check": "tsx tools/check-notification-queue.ts",
    "test:attack": "vitest run --config vitest.attack.config.ts",
    "test:tsa": "vitest run --config vitest.tsa.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "verify:ledger": "tsx tools/verify-ledger.ts",
    "recette:generate": "tsx tools/generate-recette.ts",
    "openapi:check": "tsx tools/check-openapi.ts",
    "security:scan": "tsx tools/scan-secrets.ts && tsx tools/sca.ts",
    "ci:local": "tsx tools/ci-local.ts",
    "sbom": "pnpm sbom --lockfile-only --sbom-format cyclonedx --sbom-spec-version 1.6 --sbom-type application --out sbom.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.2.0",
    "@testcontainers/postgresql": "12.2.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-fetch": "0.17.0",
    "openapi-typescript": "7.13.0",
    "pg": "8.23.1",
    "playwright": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "next": "16.4.3"
  }
}
