# Modèle de configuration. Copier vers .env.local (ignoré par Git) pour le développement.
# AUCUNE valeur réelle ici : en production, chaque valeur vient du gestionnaire de secrets.
# Une capacité dont la configuration est absente est FERMÉE (503) ; présente mais invalide :
# l'API refuse de démarrer. Vérifier sans rien afficher : pnpm config:check
NODE_ENV=
PORT=3000

# Base (Neon, ADR-0004) : sslmode=verify-full obligatoire hors base locale (N2).
DATABASE_URL=postgresql://molopay@127.0.0.1:55432/molopay_test
DATABASE_ROLE=app_rw
# Migrations livrées avec l'image (contrôle de démarrage N6).
MIGRATIONS_DIR=

# Origines autorisées des clients web (séparées par des virgules).
ALLOWED_ORIGINS=

# Connexions par clé d'accès (WebAuthn) : domaine et origines https.
STAFF_RP_ID=
STAFF_RP_ORIGINS=
PARTNER_RP_ID=
PARTNER_RP_ORIGINS=

# Poivres (base64, 32 à 64 octets), tous différents.
PIN_PEPPER=
OTP_PEPPER=
HANDOVER_PEPPER=

# Protection du numéro (C14) : clé AWS KMS en production ; clé locale hors production seulement.
PII_KMS_KEY_ARN=
PII_LOCAL_MASTER_KEY=
PHONE_INDEX_KEY_WRAPPED=

# SMS Twilio (fermé si incomplet) : clé d'API SK… + secret, ou SID de compte + jeton ; un seul expéditeur.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
