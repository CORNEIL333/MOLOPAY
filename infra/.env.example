# Modèle de configuration de la composition LOCALE (infra/compose.yaml).
# Copier vers infra/.env — jamais versionné. Base jetable, données synthétiques
# uniquement (ADR-0004). Aucun secret réel dans ce fichier.

# Image PostgreSQL épinglée par empreinte — la même que celle des tests base
# (apps/api/test/db/harness.ts). Ne pas remplacer par une étiquette mobile.
POSTGRES_IMAGE=postgres:16.15-alpine@sha256:0cefaabd882e42bcb2a2f3dc56d3ce4770560ba62fd7f197f1a2e008fd5731ab

# Mot de passe de la base locale : alphanumérique (il entre dans DATABASE_URL).
# Générer localement, ne jamais réutiliser ailleurs.
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-local

# Origines autorisées pour les écritures à cookie (liste séparée par des
# virgules). Vide : aucune écriture cross-origin acceptée (refus par défaut).
ALLOWED_ORIGINS=http://localhost:3000
